GlowScript 3.2 VPython

# Quantum Repeater Chain Visual Simulator (GlowScript-safe version)

from vpython import *
import random   # OK in GlowScript

# ---------------------
# PARAMETERS (edit these)
# ---------------------
N_repeaters = 3           # number of *intermediate* repeaters (not counting Alice & Bob)
link_length = 6.0         # visual distance between adjacent nodes
attempt_interval = 1.0    # seconds between entanglement attempts per link
p_photon_success = 0.5    # probability that a photon survives/detects across a link
p_bsm_success = 0.9       # probability that Bell-state measurement (entanglement swap) succeeds
memory_decohere_time = 20 # seconds until stored entanglement decays
photon_speed = 6.0        # visual units / second
show_photon_trails = False
# ---------------------

scene.width = 1000
scene.height = 450
scene.title = "Quantum Repeater Chain — high-level simulator\nClick scene to pause/resume"

paused = False
def toggle_pause(evt):
    global paused
    paused = not paused
scene.bind('click', toggle_pause)

# Create nodes: Alice, repeaters..., Bob
nodes = []
names = ["Alice"] + [f"R{i+1}" for i in range(N_repeaters)] + ["Bob"]
n_nodes = len(names)
start_x = - (n_nodes-1) * link_length / 2

for i, nm in enumerate(names):
    pos = vector(start_x + i*link_length, 0, 0)
    s = sphere(pos=pos, radius=0.7, color=color.gray(0.3))
    label(pos=pos + vector(0,1.1,0), text=nm, height=12, box=False)
    nodes.append({
        "name": nm,
        "sphere": s,
        "memory": None,
        "last_attempt_time": -1e9
    })

# Draw fibers
for i in range(n_nodes-1):
    a = nodes[i]["sphere"].pos
    b = nodes[i+1]["sphere"].pos
    cylinder(pos=a, axis=(b-a), radius=0.08, color=color.white*0.7)

# Legend
legend_x = start_x + (n_nodes-1)*link_length/2 + 2
label(pos=vector(legend_x, 1.8, 0), text="Legend", height=14, box=False)
sphere(pos=vector(legend_x-0.6,0.95,0), radius=0.15, color=color.gray(0.3))
label(pos=vector(legend_x, 1.3, 0), text="gray: idle", height=10, box=False)
sphere(pos=vector(legend_x-0.6,0.3,0), radius=0.15, color=color.green)
label(pos=vector(legend_x, 0.6, 0), text="green: entangled", height=10, box=False)
sphere(pos=vector(legend_x-0.6,-0.4,0), radius=0.15, color=color.red)
label(pos=vector(legend_x, -0.1, 0), text="red: decohered", height=10, box=False)

photons = []

def make_photon(start_pos, end_pos, color_ph=color.cyan):
    return {"obj": sphere(pos=start_pos, radius=0.15, color=color_ph, make_trail=show_photon_trails),
            "start": start_pos, "end": end_pos, "t0": t}

def show_node_state(i):
    node = nodes[i]
    mem = node["memory"]
    s = node["sphere"]
    if mem is None:
        s.color = color.gray(0.3)
    else:
        age = t - mem["t_stored"]
        if age > memory_decohere_time:
            s.color = color.red
        else:
            s.color = color.green

def attempt_entanglement_link(i):
    a_pos = nodes[i]["sphere"].pos
    b_pos = nodes[i+1]["sphere"].pos
    photons.append(make_photon(a_pos, b_pos))
    success = random.random() < p_photon_success
    if success:
        nodes[i]["memory"] = {"partner": i+1, "t_stored": t}
        nodes[i+1]["memory"] = {"partner": i, "t_stored": t}
        show_node_state(i)
        show_node_state(i+1)

def try_entanglement_swapping(node_index):
    if node_index <= 0 or node_index >= n_nodes-1:
        return
    left = node_index - 1
    right = node_index + 1
    left_has = nodes[left]["memory"] and nodes[left]["memory"]["partner"] == node_index
    right_has = nodes[right]["memory"] and nodes[right]["memory"]["partner"] == node_index
    if left_has and right_has:
        success = random.random() < p_bsm_success
        flash = sphere(pos=nodes[node_index]["sphere"].pos, radius=0.3, color=color.yellow, opacity=0.6)
        if success:
            nodes[left]["memory"] = {"partner": right, "t_stored": t}
            nodes[right]["memory"] = {"partner": left, "t_stored": t}
            nodes[node_index]["memory"] = None
        else:
            nodes[left]["memory"] = None
            nodes[right]["memory"] = None
            nodes[node_index]["memory"] = None
        rate(10)
        flash.visible = False
        show_node_state(left)
        show_node_state(right)
        show_node_state(node_index)

t = 0
dt = 0.05

def find_links_to_try():
    links = []
    for i in range(n_nodes-1):
        lmem = nodes[i]["memory"]
        rmem = nodes[i+1]["memory"]
        if not (lmem and rmem and lmem["partner"] == i+1 and rmem["partner"] == i):
            if t - nodes[i]["last_attempt_time"] >= attempt_interval:
                links.append(i)
    return links

last_log = 0

while True:
    rate(1/dt)
    if paused:
        continue

    new_photons = []
    for ph in photons:
        dist = mag(ph["end"] - ph["start"])
        travel_time = dist / photon_speed
        frac = (t - ph["t0"]) / travel_time
        if frac >= 1:
            ph["obj"].visible = False
        else:
            ph["obj"].pos = ph["start"] + (ph["end"] - ph["start"]) * frac
            new_photons.append(ph)
    photons[:] = new_photons

    for i in find_links_to_try():
        if random.random() < 0.5:
            nodes[i]["last_attempt_time"] = t
            attempt_entanglement_link(i)

    for idx in range(1, n_nodes-1):
        try_entanglement_swapping(idx)

    for i in range(n_nodes):
        mem = nodes[i]["memory"]
        if mem and t - mem["t_stored"] > memory_decohere_time:
            nodes[i]["memory"] = None
            show_node_state(i)

    if t - last_log > 5:
        last_log = t
        a_mem = nodes[0]["memory"]
        b_mem = nodes[-1]["memory"]
        if a_mem and b_mem and a_mem["partner"] == n_nodes-1:
            scene.caption = f"✅ SUCCESS: Alice and Bob entangled at t = {t:.1f}s"
        else:
            scene.caption = f"t = {t:.1f}s — Building entanglement chain..."

    t += dt
